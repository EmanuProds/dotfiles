{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "~/.config/opencode/AGENTS.md"
  ],
  "skills": [
    "~/.agents/skills"
  ],
  "references": {},
  "lsp": {
    "go": {
      "command": ["gopls"],
      "extensions": [".go"]
    },
    "python": {
      "command": ["ty", "server"],
      "extensions": [".py", ".pyi"]
    },
    "github-actions": {
      "command": ["gh-actions-language-server", "--stdio"],
      "extensions": [".yml", ".yaml"]
    },
    "typescript": {
      "command": ["vtsls", "--stdio"],
      "extensions": [".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs", ".mts", ".cts"]
    },
    "yaml": {
      "command": ["yaml-language-server", "--stdio"],
      "extensions": [".yaml", ".yml"]
    },
    "sql": {
      "command": ["sqls"],
      "extensions": [".sql"]
    },
    "markdown": {
      "command": ["markdown-oxide"],
      "extensions": [".md", ".markdown"]
    }
  },
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "headers": {
          "Authorization": "Bearer {env:CONTEXT7_API_KEY}"
        }
      }
    },
    "timeout": {
      "catalog": 30000,
      "execution": 30000
    }
  }
}
