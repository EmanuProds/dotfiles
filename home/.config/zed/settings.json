// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "edit_predictions": {
    "provider": "open_ai_compatible_api",
    "open_ai_compatible_api": {
      "max_output_tokens": 256,
      "model": "auto/best-fast",
      "api_url": "http://localhost:20128/v1/completions"
    }
  },
  "outline_panel": {
    "dock": "left"
  },
  "context_servers": {
    "mcp-server-context7": {
      "enabled": true,
      "remote": false,
      "settings": {
        "context7_api_key": "ctx7sk-8df4496f-7df6-48ae-bb6d-d752125c7fe2"
      }
    }
  },
  "cli_default_open_behavior": "existing_window",
  "relative_line_numbers": "disabled",
  "gutter": {
    "git_gutter_width": "default",
    "min_line_number_digits": 1,
    "folds": true,
    "bookmarks": true,
    "runnables": true,
    "breakpoints": true,
    "line_numbers": true
  },
  "prettier": {
    "allowed": true
  },
  "tab_bar": {
    "show_nav_history_buttons": false
  },
  "tabs": {
    "show_diagnostics": "all",
    "file_icons": true,
    "git_status": true
  },
  "title_bar": {
    "show_branch_status_icon": true
  },
  "status_bar": {
    "line_endings_button": false
  },
  "git_panel": {
    "dock": "left",
    "show_count_badge": false,
    "file_icons": true,
    "tree_view": true
  },
  "project_panel": {
    "dock": "left",
    "bold_folder_labels": true,
    "hide_root": true,
    "diagnostic_badges": true,
    "git_status_indicator": true,
    "scrollbar": {
      "horizontal_scroll": true
    }
  },
  "languages": {
    "TypeScript": {
      "formatter": "prettier",
      "tab_size": 2,
    },
    "JavaScript": {
      "formatter": "prettier",
      "tab_size": 2,
    },
    "JSON": {
      "formatter": "prettier",
      "tab_size": 2
    },
    "HTML": {
      "formatter": "prettier",
      "tab_size": 2
    },
    "CSS": {
      "language_servers": [
        "tailwindcss-intellisense-css",
        "!vscode-css-language-server"
      ],
      "formatter": "prettier",
      "tab_size": 2
    },
  },
  "agent": {
    "sandbox_permissions": {
      "allow_unsandboxed": true
    },
    "tool_permissions": {
      "default": "allow",
      "tools": {
        "skill": {
          "default": "allow"
        },
        "search_web": {
          "default": "allow"
        },
        "fetch": {
          "default": "allow"
        },
        "copy_path": {
          "default": "allow"
        },
        "create_directory": {
          "default": "allow"
        },
        "move_path": {
          "default": "allow"
        },
        "write_file": {
          "default": "allow"
        },
        "edit_file": {
          "default": "allow"
        },
        "terminal": {
          "default": "allow"
        }
      }
    },
    "show_turn_stats": true,
    "play_sound_when_agent_done": "always",
    "sidebar_side": "right",
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "agent_servers": {
    "opencode": {
      "type": "registry",
    },
  },
  "indent_guides": {
    "background_coloring": "indent_aware",
    "coloring": "disabled",
  },
  "toolbar": {
    "code_actions": false,
  },
  "collaboration_panel": {
    "dock": "right",
  },
  "debugger": {
    "dock": "bottom",
  },
  "ssh_connections": [
    {
      "host": "oracle-cloud",
      "args": [],
      "projects": [
        {
          "paths": ["/home/opc"],
        },
      ],
    },
  ],
  "session": {
    "trust_all_worktrees": true,
  },
  "base_keymap": "VSCode",
  "ui_font_size": 16.0,
  "buffer_font_size": 15.0,
  "theme": {
    "mode": "system",
    "dark": "Zedwaita Dark",
    "light": "Zedwaita Light"
  },
  "icon_theme": {
    "mode": "system",
    "light": "Colored Zed Icons Theme Light",
    "dark": "Colored Zed Icons Theme Dark",
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false,
  },
}
